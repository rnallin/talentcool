{
  "installCommand": "corepack enable && pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm run --filter @workspace/hr-platform build",
  "outputDirectory": "artifacts/hr-platform/dist/public",
  "framework": null,
  "build": {
    "env": {
      "PORT": "5173",
      "BASE_PATH": "/"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
